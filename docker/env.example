# =============================================================================
# docker/env.example
# -----------------------------------------------------------------------------
# 这是 Docker Compose 用的环境变量模板，不是 Go 程序自己读的配置文件。
#
# 使用步骤：
# 1) 复制：cp docker/env.example docker/.env
# 2) 编辑 docker/.env，至少把 EMBEDDING_API_KEY 换成真实密钥
# 3) 启动：docker compose -f docker/docker-compose.yml --env-file docker/.env up -d --build
#
# 为什么要绕一层？
# - Go 服务启动时只读“进程环境变量”
# - 它不会自动加载 .env 文件
# - compose 的 --env-file 会把这里的键值注入到容器环境里
#
# 安全提醒：
# - docker/.env 通常包含密钥，不要提交到 Git
# - 本文件只放示例值，可以提交
# =============================================================================

# ---- 基础 ----

# 容器时区。影响日志时间显示；不改也能跑。
TZ=Asia/Shanghai

# 把容器内 8081 映射到宿主机的哪个端口。
# 浏览器/curl 访问：http://localhost:8081
APP_HOST_PORT=8081

# 把 PostgreSQL 容器 5432 映射到宿主机的哪个端口。
# 本机已有数据库占用 5432 时，可改成 5433。
POSTGRES_HOST_PORT=5432

# ---- PostgreSQL（数据库容器自己用）----

# 首次初始化时创建的数据库名。
POSTGRES_DB=kenagent

# 首次初始化时创建的用户名。
POSTGRES_USER=travelagent

# 首次初始化时创建的密码。
# 这是本地示例密码；生产务必改强，并同步修改下面的 POSTGRESQL_DSN。
POSTGRES_PASSWORD=travelagent

# ---- PostgreSQL（TravelAgent 应用连接串）----

# 应用连接数据库的完整 DSN。
# 关键点：主机名写服务名 postgres，不要写 localhost。
# localhost 在 app 容器里指自己，连不到旁边的数据库容器。
# 用户名/密码/库名要和上面 POSTGRES_* 保持一致。
POSTGRESQL_DSN=postgres://travelagent:travelagent@postgres:5432/kenagent?sslmode=disable

# 连接池最多同时打开多少连接。
POSTGRESQL_MAX_OPEN_CONNS=10

# 连接池最多保留多少空闲连接。
POSTGRESQL_MAX_IDLE_CONNS=5

# 单个连接最长复用时间，到期后回收重建。
POSTGRESQL_CONN_MAX_LIFETIME=30m

# 单个连接最长空闲时间，空太久就关掉。
POSTGRESQL_CONN_MAX_IDLE_TIME=5m

# ---- HTTP 服务生命周期 ----

# 应用在容器内监听的端口。Dockerfile EXPOSE 和 healthcheck 默认按 8081。
GO_AGENT_PORT=8081

# 读取请求头最长等待时间。太小可能导致慢客户端失败。
HTTP_READ_HEADER_TIMEOUT=5s

# 读取完整请求体最长等待时间。
HTTP_READ_TIMEOUT=60s

# 写响应最长等待时间。
# 文档分块/Embedding 是同步接口，所以默认给 5 分钟，避免处理到一半被掐断。
HTTP_WRITE_TIMEOUT=5m

# Keep-Alive 空闲连接最多挂多久。
HTTP_IDLE_TIMEOUT=60s

# 收到停止信号后，最多等多久让正在处理的请求结束。
HTTP_SHUTDOWN_TIMEOUT=15s

# ---- 对象存储 ----
# TravelAgent 支持两种模式，二选一：
# A) 本地目录（默认，最简单）
# B) S3 兼容存储（MinIO / RustFS / AWS S3）

# false = 本地存储；true = S3/MinIO。
# 若要用 compose 的 MinIO，请改成 true，并加：--profile s3
RUSTFS_ENABLED=false

# 本地存储根目录（仅 RUSTFS_ENABLED=false 时生效）。
# compose 会把命名卷挂到 /data/storage，数据可持久化。
LOCAL_STORAGE_DIR=/data/storage

# 下面这些在本地模式下通常用不到，但保留默认值，
# 方便你一键切换到 --profile s3。

# S3 桶名。启用 s3 profile 时 minio-init 会尝试创建它。
RUSTFS_BUCKET_NAME=travelagent

# S3 endpoint。
# 容器内访问 MinIO 请写 http://minio:9000
# 如果从宿主机程序去连，才写成 http://localhost:9000
RUSTFS_ENDPOINT=http://minio:9000

# AWS SDK 签名用的 region。MinIO 一般填 us-east-1 即可。
RUSTFS_REGION=us-east-1

# 对象存储 Access Key（MinIO root user）
RUSTFS_ACCESS_KEY=minioadmin

# 对象存储 Secret Key（MinIO root password）
RUSTFS_SECRET_KEY=minioadmin

# true 表示 path-style：http://endpoint/bucket/key
# MinIO / RustFS 通常需要 true；AWS 官方 S3 有时用 virtual-host style。
RUSTFS_PATH_STYLE=true

# 宿主机访问 MinIO API 的端口映射。
MINIO_API_HOST_PORT=9000

# 宿主机访问 MinIO Web 控制台的端口映射。
MINIO_CONSOLE_HOST_PORT=9001

# ---- Embedding（必填）----

# 向量模型 API 密钥。没有它 compose 会拒绝启动 app。
# 请改成你的真实 key，不要提交真实 key 到 Git。
EMBEDDING_API_KEY=replace-me

# OpenAI 兼容协议的服务根地址。
# 默认指向阿里云 DashScope 兼容模式。
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode

# 模型名称，必须是服务端支持的 embedding 模型。
EMBEDDING_MODEL=text-embedding-v3

# 向量维度。必须与数据库列 vector(1536) 完全一致，否则写入会失败。
EMBEDDING_DIMENSIONS=1536

# 单次 Embedding HTTP 请求超时。
EMBEDDING_TIMEOUT=60s

# ---- 上传策略与日志 ----

# 上传接口允许的文件扩展名，逗号分隔。
# 注意：pdf/doc/docx 可上传，但当前 MVP 分块阶段可能仍提示暂不支持二进制解析。
KNOWLEDGE_DOCUMENT_ALLOWED_EXTENSIONS=pdf,doc,docx,txt,md,markdown,html,htm

# 单个上传文件大小上限。
KNOWLEDGE_DOCUMENT_MAX_SIZE=50MB

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 日志格式：
# - json：适合采集和线上
# - text：适合本机直接看
LOG_FORMAT=json

# ---- Agent / ChatModel (Eino) ----
# 模型目录 JSON。密钥只用占位值；真实密钥通过运行环境注入，禁止提交。
# available 状态表示配置完整且启用，不是实时供应商健康探测。
AGENT_MODELS_JSON=[{"id":"qwen-plus","displayName":"Qwen Plus","provider":"dashscope","baseURL":"https://dashscope.aliyuncs.com/compatible-mode/v1","model":"qwen-plus","apiKey":"replace-me","timeout":"60s","enabled":true}]
AGENT_DEFAULT_MODEL_ID=qwen-plus
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_MESSAGE_CHARS=4000
AGENT_MAX_TOTAL_CHARS=16000
AGENT_MAX_ITERATIONS=8
