# Frontend environment template.
# Copy values into .env.local for local overrides if needed. Vite loads .env* automatically.
# Never put model API keys, access keys, or provider secrets here.

# API root URL. Leave empty to use same-origin paths (recommended).
# Dev: Vite proxies /api -> http://localhost:8081
# Prod: empty when frontend is served same-origin as the backend; set origin only when split.
VITE_API_BASE_URL=
